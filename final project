# --- Class Definitions ---
class Transaction:
    def __init__(self, date, amount, category, account, description, payment_mode):
        self.date = date
        self.description = description
        self.category = category
        self.account = account
        self.payment_mode = payment_mode  # Matches CSV header
        
        # [RUBRIC: Encapsulation] Amount is private
        try:
            self.__amount = float(amount)
            if self.__amount < 0:
                self.__amount = 0.0
        except ValueError:
            self.__amount = 0.0

    @property
    def amount(self):
        return self.__amount


class Income(Transaction):
    def __init__(self, date, amount, category, account, description, payment_mode):
        super().__init__(date, amount, category, account, description, payment_mode)
        self.type = "Income"


class Expense(Transaction):
    def __init__(self, date, amount, category, account, description, payment_mode):
        super().__init__(date, amount, category, account, description, payment_mode)
        self.type = "Expense"


# --- Global Variables ---
budget_list = []
FILENAME = "budget_data.csv"

# [RUBRIC: Collections] Tuple used for headers
CSV_HEADER = (
    "Date",
    "type",          # Record Type (Income/Expense)
    "amount",
    "category", 
    "account",
    "description",
    "payment_mode",  # Payment Method (Card, Cash, etc)
)


# --- Backend Functions ---

def validate_amount(amount_str):
    """
    [RUBRIC: Loops] Uses a 'while' loop to ensure amount is valid.
    """
    valid = False
    value = 0.0

    while not valid:
        try:
            value = float(amount_str)
            if value < 0:
                print("Amount cannot be negative.")
                break
            valid = True
        except ValueError:
            print("Invalid number format.")
            break

    return value


def save_data_csv():
    """Saves the current budget_list to CSV file."""
    try:
        with open(FILENAME, "w", newline="", encoding="utf-8") as file:
            writer = csv.DictWriter(file, fieldnames=CSV_HEADER)
            writer.writeheader()

            for item in budget_list:
                row = {
                    "Date": item.date,
                    "type": item.type,
                    "amount": "{:.2f}".format(item.amount),
                    "category": item.category,
                    "account": item.account,
                    "description": item.description,
                    "payment_mode": item.payment_mode,
                }
                writer.writerow(row)
        print(f"Data saved successfully: {len(budget_list)}")
        return
    except Exception as e:
        print(f"Unsuccessfully Save: {e}")
        return


def load_from_csv():
    """Loads data from CSV file into budget_list."""
    global budget_list
    budget_list = [] # Clearing list here is CORRECT to avoid duplicates on reload

    if not os.path.exists(FILENAME):
        return

    try:
        with open(FILENAME, "r", encoding="utf-8") as file:
            reader = csv.DictReader(file)

            for row in reader:
                # Robust loading: handle missing keys safely and handle case sensitivity
                # Try 'Date' (Header format) first, then 'date' (Legacy format)
                date = row.get("Date") or row.get("date")
                type_str = row.get("type") or row.get("Type")
                
                # [FIX] Check for missing type to prevent phantom records
                if not type_str:
                    continue

                try:
                    # Handle 'amount' or 'Amount'
                    amt_val = row.get("amount") or row.get("Amount") or 0
                    amount = float(amt_val)
                except ValueError:
                    amount = 0.0
                    
                cat = row.get("category") or row.get("Category") or "-"
                acc = row.get("account") or row.get("Account") or "-"
                desc = row.get("description") or row.get("Description") or "-"
                pm = row.get("payment_mode") or row.get("Payment_Mode") or "-"

                # [FIX] Use capitalize() so "income" (lowercase) is correctly read as Income
                if type_str.capitalize() == "Income":
                    obj = Income(date, amount, cat, acc, desc, pm)
                else:
                    obj = Expense(date, amount, cat, acc, desc, pm)

                budget_list.append(obj)
            
            print("Successful Load")
            return True

    except Exception as e:
        print("Unsuccessful Load", str(e))
        return False


def add_record(record_type, amount, category, account, description, payment_mode):
    """Creates a new record and saves it."""
    current_date = dt.datetime.now().strftime("%Y-%m-%d")

    if record_type.capitalize() == "Income":
        new_transaction = Income(
            current_date, amount, category, account, description, payment_mode
        )
    else:
        new_transaction = Expense(
            current_date, amount, category, account, description, payment_mode
        )

    budget_list.append(new_transaction)
    save_data_csv()
    print(f"Record added: {record_type} - {description} - RM {amount}")


def get_balance_summary():
    """Calculates totals and returns a dictionary."""
    total_income = 0
    total_expense = 0
    
    # [RUBRIC: Loop] Loop through list to calculate totals
    for item in budget_list:
        if item.type == "Income":
            total_income += item.amount
        else:
            total_expense += item.amount

    balance = total_income - total_expense
    return {"income": total_income, "expense": total_expense, "balance": balance}


